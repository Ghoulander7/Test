<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Game screen -->
    <LinearLayout
        android:id="@+id/gameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10.0"
            android:textSize="32sp"
            android:textColor="#FF4444"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/counterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="100sp"
            android:textColor="#FFD700"
            android:fontFamily="sans-serif-light"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/goalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GOAL: 100"
            android:textSize="14sp"
            android:textColor="#888888"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.3"
            android:layout_marginBottom="32dp" />

        <FrameLayout
            android:id="@+id/chestContainer"
            android:layout_width="240dp"
            android:layout_height="200dp"
            android:layout_marginBottom="40dp" />

    </LinearLayout>

    <!-- Game Over overlay -->
    <LinearLayout
        android:id="@+id/gameOverLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#DD121212"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME OVER"
            android:textSize="52sp"
            android:textColor="#FF4444"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/finalScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Final Treasure: 0"
            android:textSize="24sp"
            android:textColor="#FFD700"
            android:fontFamily="sans-serif-light"
            android:layout_marginBottom="48dp" />

        <Button
            android:id="@+id/restartButton"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="TRY AGAIN"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E88E5"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Win overlay -->
    <LinearLayout
        android:id="@+id/winLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#DD121212"
        android:visibility="gone"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOU WIN!"
            android:textSize="52sp"
            android:textColor="#FFD700"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/winScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Treasure: 100"
            android:textSize="24sp"
            android:textColor="#FFD700"
            android:fontFamily="sans-serif-light"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/winTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time left: 0.0s"
            android:textSize="20sp"
            android:textColor="#4FC3F7"
            android:fontFamily="sans-serif-light"
            android:layout_marginBottom="48dp" />

        <Button
            android:id="@+id/playAgainButton"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="PLAY AGAIN"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E88E5"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</FrameLayout>
